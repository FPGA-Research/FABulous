{{ base_sdc }}

# Loop-break cuts generated by FABulous for {{ design_name }}.
proc fabulous_loop_break_driver {net} {
    set pins [get_pins -of_objects [get_nets $net] -filter "direction==output"]
    if {[llength $pins] != 1} {
        error "Loop-break net $net has [llength $pins] driver pins, expected 1."
    }
    return $pins
}
{% for net in nets %}
set_disable_timing [fabulous_loop_break_driver {{ "{" ~ net ~ "}" }}]
{% endfor %}
