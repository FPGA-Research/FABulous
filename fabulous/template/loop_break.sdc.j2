{{ base_sdc }}

# Loop-break cuts generated by FABulous for {{ design_name }}.
# OpenROAD keeps one name of an assign alias and OpenSTA keeps both, so a cut
# lists every alias and the same pin can return once per name. OpenSTA spells the
# pin direction `output`; `direction==out` selects no pin.
proc fabulous_loop_break_driver {aliases} {
    set nets [get_nets -quiet $aliases]
    set pins [lsort -unique [get_pins -of_objects $nets -filter "direction==output"]]
    if {[llength $pins] != 1} {
        error "Loop-break net $aliases has [llength $pins] driver pins, expected 1."
    }
    return $pins
}
{% for aliases in nets %}
set_disable_timing [fabulous_loop_break_driver {{ "{" ~ aliases | join(" ") ~ "}" }}]
{% endfor %}
